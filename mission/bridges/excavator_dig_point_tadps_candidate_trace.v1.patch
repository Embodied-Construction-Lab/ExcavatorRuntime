diff --git a/excavator_dig_point/include/excavator_dig_point/tadps_candidate_trace.hpp b/excavator_dig_point/include/excavator_dig_point/tadps_candidate_trace.hpp
new file mode 100644
index 0000000..de98daa
--- /dev/null
+++ b/excavator_dig_point/include/excavator_dig_point/tadps_candidate_trace.hpp
@@ -0,0 +1,167 @@
+#ifndef EXCAVATOR_DIG_POINT__TADPS_CANDIDATE_TRACE_HPP_
+#define EXCAVATOR_DIG_POINT__TADPS_CANDIDATE_TRACE_HPP_
+
+#include <array>
+#include <openssl/sha.h>
+#include <cmath>
+#include <cstdint>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace excavator_dig_point
+{
+
+struct TadpsCandidateTraceEvidence
+{
+  std::string candidate_id;
+  std::array<double, 3> position_m{0.0, 0.0, 0.0};
+  bool terrain_valid{true};
+  double surface_height_m{0.0};
+  double local_soil_height_score{0.0};
+  double confidence_score{0.0};
+  double edge_clearance_score{0.0};
+  double relative_height_score{0.0};
+  double roughness_penalty{0.0};
+};
+
+inline std::string escapeTadpsJsonString(const std::string & value)
+{
+  std::ostringstream output;
+  output << std::hex << std::setfill('0');
+  for (const unsigned char character : value) {
+    switch (character) {
+      case '"': output << "\\\""; break;
+      case '\\': output << "\\\\"; break;
+      case '\b': output << "\\b"; break;
+      case '\f': output << "\\f"; break;
+      case '\n': output << "\\n"; break;
+      case '\r': output << "\\r"; break;
+      case '\t': output << "\\t"; break;
+      default:
+        if (character < 0x20U) {
+          output << "\\u" << std::setw(4) << static_cast<unsigned int>(character);
+        } else {
+          output << static_cast<char>(character);
+        }
+    }
+  }
+  return output.str();
+}
+
+inline void validateTadpsNumber(double value, const char * field)
+{
+  if (!std::isfinite(value)) {
+    throw std::invalid_argument(std::string(field) + " must be finite");
+  }
+}
+
+inline void validateTadpsNormalized(double value, const char * field)
+{
+  validateTadpsNumber(value, field);
+  if (value < 0.0 || value > 1.0) {
+    throw std::invalid_argument(std::string(field) + " must be in [0, 1]");
+  }
+}
+
+inline bool isLowercaseSha256(const std::string & value)
+{
+  if (value.size() != 64U) {
+    return false;
+  }
+  for (const char character : value) {
+    if (!((character >= '0' && character <= '9') ||
+      (character >= 'a' && character <= 'f')))
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+inline std::string sha256Hex(const std::uint8_t * data, std::size_t size)
+{
+  if (data == nullptr && size != 0U) {
+    throw std::invalid_argument("SHA-256 input pointer is null");
+  }
+  std::array<unsigned char, SHA256_DIGEST_LENGTH> digest{};
+  if (SHA256(data, size, digest.data()) == nullptr) {
+    throw std::runtime_error("SHA-256 calculation failed");
+  }
+  std::ostringstream output;
+  output << std::hex << std::setfill('0');
+  for (const unsigned char byte : digest) {
+    output << std::setw(2) << static_cast<unsigned int>(byte);
+  }
+  return output.str();
+}
+
+inline std::string buildTadpsCandidateFrameJson(
+  const std::string & sequence_id,
+  const std::string & frame_id,
+  std::uint64_t frame_index,
+  double stamp_s,
+  const std::string & map_sha256,
+  const std::vector<TadpsCandidateTraceEvidence> & candidates)
+{
+  if (sequence_id.empty() || frame_id.empty()) {
+    throw std::invalid_argument("sequence_id and frame_id must be non-empty");
+  }
+  validateTadpsNumber(stamp_s, "stamp_s");
+  if (stamp_s < 0.0) {
+    throw std::invalid_argument("stamp_s must be non-negative");
+  }
+  if (!isLowercaseSha256(map_sha256)) {
+    throw std::invalid_argument("map_sha256 must be a lowercase SHA-256 digest");
+  }
+
+  std::ostringstream output;
+  output << std::setprecision(17);
+  output << "{\"schema_version\":\"tadps_selector_candidate_frame.v1\"";
+  output << ",\"record_type\":\"complete_preselection_candidate_set\"";
+  output << ",\"sequence_id\":\"" << escapeTadpsJsonString(sequence_id) << "\"";
+  output << ",\"frame_id\":\"" << escapeTadpsJsonString(frame_id) << "\"";
+  output << ",\"frame_index\":" << frame_index;
+  output << ",\"stamp_s\":" << stamp_s;
+  output << ",\"map_sha256\":\"" << map_sha256 << "\"";
+  output << ",\"candidate_set_complete\":true,\"candidates\":[";
+  for (std::size_t index = 0; index < candidates.size(); ++index) {
+    const auto & candidate = candidates[index];
+    if (candidate.candidate_id.empty()) {
+      throw std::invalid_argument("candidate_id must be non-empty");
+    }
+    for (const double coordinate : candidate.position_m) {
+      validateTadpsNumber(coordinate, "position_m");
+    }
+    validateTadpsNumber(candidate.surface_height_m, "surface_height_m");
+    validateTadpsNormalized(
+      candidate.local_soil_height_score, "local_soil_height_score");
+    validateTadpsNormalized(candidate.confidence_score, "confidence_score");
+    validateTadpsNormalized(candidate.edge_clearance_score, "edge_clearance_score");
+    validateTadpsNormalized(candidate.relative_height_score, "relative_height_score");
+    validateTadpsNormalized(candidate.roughness_penalty, "roughness_penalty");
+    if (index != 0U) {
+      output << ',';
+    }
+    output << "{\"candidate_id\":\"" << escapeTadpsJsonString(candidate.candidate_id)
+           << "\",\"position_m\":[" << candidate.position_m[0] << ','
+           << candidate.position_m[1] << ',' << candidate.position_m[2]
+           << "],\"features\":{";
+    output << "\"terrain_valid\":" << (candidate.terrain_valid ? "true" : "false");
+    output << ",\"surface_height_m\":" << candidate.surface_height_m;
+    output << ",\"local_soil_height_score\":" << candidate.local_soil_height_score;
+    output << ",\"confidence_score\":" << candidate.confidence_score;
+    output << ",\"edge_clearance_score\":" << candidate.edge_clearance_score;
+    output << ",\"relative_height_score\":" << candidate.relative_height_score;
+    output << ",\"roughness_penalty\":" << candidate.roughness_penalty;
+    output << "},\"downstream_planner_accepted\":null}";
+  }
+  output << "]}";
+  return output.str();
+}
+
+}  // namespace excavator_dig_point
+
+#endif  // EXCAVATOR_DIG_POINT__TADPS_CANDIDATE_TRACE_HPP_
diff --git a/excavator_dig_point/include/excavator_dig_point/tadps_candidate_trace_publisher.hpp b/excavator_dig_point/include/excavator_dig_point/tadps_candidate_trace_publisher.hpp
new file mode 100644
index 0000000..90066c5
--- /dev/null
+++ b/excavator_dig_point/include/excavator_dig_point/tadps_candidate_trace_publisher.hpp
@@ -0,0 +1,167 @@
+#ifndef EXCAVATOR_DIG_POINT__TADPS_CANDIDATE_TRACE_PUBLISHER_HPP_
+#define EXCAVATOR_DIG_POINT__TADPS_CANDIDATE_TRACE_PUBLISHER_HPP_
+
+#include "excavator_dig_point/tadps_candidate_trace.hpp"
+
+#include <grid_map_msgs/msg/grid_map.hpp>
+#include <rclcpp/rclcpp.hpp>
+#include <rclcpp/serialization.hpp>
+#include <rclcpp/serialized_message.hpp>
+#include <std_msgs/msg/string.hpp>
+
+#include <atomic>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace excavator_dig_point
+{
+
+inline std::string serializedGridMapSha256(
+  const grid_map_msgs::msg::GridMap & message)
+{
+  rclcpp::Serialization<grid_map_msgs::msg::GridMap> serializer;
+  rclcpp::SerializedMessage serialized;
+  serializer.serialize_message(&message, &serialized);
+  const auto & raw = serialized.get_rcl_serialized_message();
+  return sha256Hex(raw.buffer, raw.buffer_length);
+}
+
+class TadpsCandidateTracePublisher
+{
+public:
+  TadpsCandidateTracePublisher(
+    rclcpp::Node & node,
+    std::string topic,
+    std::string sequence_id,
+    std::size_t maximum_pending_frames)
+  : logger_(node.get_logger()),
+    sequence_id_(std::move(sequence_id)),
+    maximum_pending_frames_(maximum_pending_frames)
+  {
+    if (topic.empty() || sequence_id_.empty()) {
+      throw std::invalid_argument("candidate trace topic and sequence_id must be non-empty");
+    }
+    if (maximum_pending_frames_ < 1U || maximum_pending_frames_ > 1024U) {
+      throw std::invalid_argument("candidate trace queue depth must be in [1, 1024]");
+    }
+    publisher_ = node.create_publisher<std_msgs::msg::String>(
+      topic, rclcpp::QoS(rclcpp::KeepLast(maximum_pending_frames_))
+      .reliable().durability_volatile());
+    worker_ = std::thread(&TadpsCandidateTracePublisher::run, this);
+  }
+
+  TadpsCandidateTracePublisher(const TadpsCandidateTracePublisher &) = delete;
+  TadpsCandidateTracePublisher & operator=(const TadpsCandidateTracePublisher &) = delete;
+
+  ~TadpsCandidateTracePublisher()
+  {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stopping_ = true;
+    }
+    condition_.notify_one();
+    if (worker_.joinable()) {
+      worker_.join();
+    }
+  }
+
+  bool enqueue(
+    grid_map_msgs::msg::GridMap::ConstSharedPtr message,
+    std::uint64_t frame_index,
+    std::vector<TadpsCandidateTraceEvidence> candidates)
+  {
+    if (!message) {
+      return false;
+    }
+    PendingFrame frame{std::move(message), frame_index, std::move(candidates)};
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (stopping_ || queue_.size() >= maximum_pending_frames_) {
+        dropped_frames_.fetch_add(1U, std::memory_order_relaxed);
+        return false;
+      }
+      queue_.push_back(std::move(frame));
+    }
+    condition_.notify_one();
+    return true;
+  }
+
+  std::uint64_t droppedFrames() const noexcept
+  {
+    return dropped_frames_.load(std::memory_order_relaxed);
+  }
+
+  std::uint64_t failedFrames() const noexcept
+  {
+    return failed_frames_.load(std::memory_order_relaxed);
+  }
+
+private:
+  struct PendingFrame
+  {
+    grid_map_msgs::msg::GridMap::ConstSharedPtr message;
+    std::uint64_t frame_index;
+    std::vector<TadpsCandidateTraceEvidence> candidates;
+  };
+
+  void run() noexcept
+  {
+    while (true) {
+      PendingFrame frame;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        condition_.wait(lock, [this]() {return stopping_ || !queue_.empty();});
+        if (queue_.empty()) {
+          if (stopping_) {
+            return;
+          }
+          continue;
+        }
+        frame = std::move(queue_.front());
+        queue_.pop_front();
+      }
+      try {
+        const auto & header = frame.message->header;
+        const double stamp_s = static_cast<double>(header.stamp.sec) +
+          static_cast<double>(header.stamp.nanosec) * 1.0e-9;
+        std_msgs::msg::String output;
+        output.data = buildTadpsCandidateFrameJson(
+          sequence_id_, header.frame_id, frame.frame_index, stamp_s,
+          serializedGridMapSha256(*frame.message), frame.candidates);
+        publisher_->publish(output);
+      } catch (const std::exception & error) {
+        failed_frames_.fetch_add(1U, std::memory_order_relaxed);
+        RCLCPP_WARN(
+          logger_, "TADPS candidate trace frame skipped: %s", error.what());
+      } catch (...) {
+        failed_frames_.fetch_add(1U, std::memory_order_relaxed);
+        RCLCPP_WARN(logger_, "TADPS candidate trace frame skipped: unknown error");
+      }
+    }
+  }
+
+  rclcpp::Logger logger_;
+  std::string sequence_id_;
+  std::size_t maximum_pending_frames_;
+  rclcpp::Publisher<std_msgs::msg::String>::SharedPtr publisher_;
+  std::mutex mutex_;
+  std::condition_variable condition_;
+  std::deque<PendingFrame> queue_;
+  bool stopping_{false};
+  std::thread worker_;
+  std::atomic<std::uint64_t> dropped_frames_{0U};
+  std::atomic<std::uint64_t> failed_frames_{0U};
+};
+
+}  // namespace excavator_dig_point

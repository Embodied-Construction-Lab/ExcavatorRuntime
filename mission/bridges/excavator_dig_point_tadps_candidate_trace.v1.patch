+TEST(TadpsCandidateTrace, BuildsCompleteStrictCandidateFrame)
+{
+  TadpsCandidateTraceEvidence candidate;
+  candidate.candidate_id = "pile-7-cell-12-34";
+  candidate.position_m = {1.0, -0.2, 0.4};
+  candidate.terrain_valid = true;
+  candidate.surface_height_m = 0.4;
+  candidate.local_soil_height_score = 0.8;
+  candidate.confidence_score = 0.9;
+  candidate.edge_clearance_score = 0.7;
+  candidate.relative_height_score = 0.6;
+  candidate.roughness_penalty = 0.1;
+
+  const std::string payload = buildTadpsCandidateFrameJson(
+    "pile-stage-001", "world", 42U, 123.5,
+    std::string(64U, 'a'), std::vector<TadpsCandidateTraceEvidence>{candidate});
+
+  EXPECT_NE(payload.find("\"schema_version\":\"tadps_selector_candidate_frame.v1\""),
+    std::string::npos);
+  EXPECT_NE(payload.find("\"record_type\":\"complete_preselection_candidate_set\""),
+    std::string::npos);
+  EXPECT_NE(payload.find("\"candidate_set_complete\":true"), std::string::npos);
+  EXPECT_NE(payload.find("\"candidate_id\":\"pile-7-cell-12-34\""),
+    std::string::npos);
+  EXPECT_NE(payload.find("\"downstream_planner_accepted\":null"), std::string::npos);
+  EXPECT_NE(payload.find("\"frame_index\":42"), std::string::npos);
+}
+
+TEST(TadpsCandidateTrace, EscapesRunControlledJsonStrings)
+{
+  const std::string payload = buildTadpsCandidateFrameJson(
+    "pile\"stage\\001", "world\nframe", 0U, 1.0,
+    std::string(64U, 'b'), {});
+
+  EXPECT_NE(payload.find("pile\\\"stage\\\\001"), std::string::npos);
+  EXPECT_NE(payload.find("world\\nframe"), std::string::npos);
+}
+
+TEST(TadpsCandidateTrace, HashesSerializedGridMapBytesWithSha256)
+{
+  const std::string bytes = "abc";
+
+  EXPECT_EQ(
+    sha256Hex(reinterpret_cast<const std::uint8_t *>(bytes.data()), bytes.size()),
+    "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+}
+
+TEST(TadpsCandidateTrace, PublishesSerializedMapBoundEvidenceFromWorker)
+{
+  rclcpp::init(0, nullptr);
+  auto producer = std::make_shared<rclcpp::Node>("tadps_trace_test_producer");
+  auto consumer = std::make_shared<rclcpp::Node>("tadps_trace_test_consumer");
+  std::string received;
+  auto subscription = consumer->create_subscription<std_msgs::msg::String>(
+    "/test/tadps_candidate_frame", rclcpp::QoS(8).reliable(),
+    [&received](std_msgs::msg::String::ConstSharedPtr message) {
+      received = message->data;
+    });
+  (void)subscription;
+  auto trace = std::make_unique<TadpsCandidateTracePublisher>(
+    *producer, "/test/tadps_candidate_frame", "pile-stage-001", 4U);
+  auto map = std::make_shared<grid_map_msgs::msg::GridMap>();
+  map->header.frame_id = "world";
+  map->header.stamp.sec = 123;
+  map->header.stamp.nanosec = 500000000U;
+
+  ASSERT_TRUE(trace->enqueue(map, 7U, {}));
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
+  while (received.empty() && std::chrono::steady_clock::now() < deadline) {
+    rclcpp::spin_some(consumer);
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+  trace.reset();
+  rclcpp::shutdown();
+
+  EXPECT_NE(received.find("\"frame_index\":7"), std::string::npos);
+  EXPECT_NE(received.find("\"stamp_s\":123.5"), std::string::npos);
+  EXPECT_NE(received.find("\"map_sha256\":"), std::string::npos);
+}
